# Open WebUI (Ollama) — trainer free-text AI assist
# Base URL of your WebUI instance (e.g. http://192.168.1.10:8080).
# /api/chat/completions is appended automatically unless the URL already ends with it.
AI_BASE_URL="http://127.0.0.1:8080"
# API key from Open WebUI → Settings → Account (Bearer token)
