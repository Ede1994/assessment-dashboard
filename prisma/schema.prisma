generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum Role {
  STUDENT
  TRAINER
}

enum QuestionType {
  FREE_TEXT
  MULTIPLE_CHOICE
  CODING
}

enum CodingLanguage {
  PYTHON
  JAVASCRIPT
}

model User {
  id           String               @id @default(cuid())
  username     String               @unique
  passwordHash String
  role         Role
  displayName  String
  submissions  Submission[]
  assignments  QuestionAssignment[]
  timeSpent    TimeSpent[]
  createdAt    DateTime             @default(now())
}

model Category {
  id        String     @id @default(cuid())
  slug      String     @unique
  name      String
  icon      String
  color     String
  sortOrder Int
  questions Question[]
}

model Question {
  id          String                       @id @default(cuid())
  categoryId  String
  category    Category                     @relation(fields: [categoryId], references: [id])
  title       String
  prompt      String
  roundLabel  String
  tags        String
  type            QuestionType
  codeSnippet     String?
  starterCode     String?
  codingLanguage  CodingLanguage?
  sortOrder       Int
  choices     Choice[]
  solution    Solution?
  submissions Submission[]
  assignments QuestionAssignment[]
  templates   AssignmentTemplateQuestion[]
  timeSpent   TimeSpent[]
}

model Choice {
  id          String       @id @default(cuid())
  questionId  String
  question    Question     @relation(fields: [questionId], references: [id], onDelete: Cascade)
  label       String
  isCorrect   Boolean      @default(false)
  sortOrder   Int          @default(0)
  submissions Submission[]
}

model Solution {
  id           String   @id @default(cuid())
  questionId   String   @unique
  question     Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  idealAnswer  String
  explanation  String
  codeSolution String?
  blankAnswers String?
}

model Submission {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId       String
  question         Question  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  textAnswer       String?
  selectedChoiceId String?
  selectedChoice   Choice?   @relation(fields: [selectedChoiceId], references: [id])
  aiFeedback       String?
  aiReviewedAt     DateTime?
  trainerScore     Int?
  trainerPassed    Boolean?
  trainerComment   String?
  feedbackReleased Boolean   @default(false)
  trainerGradedAt  DateTime?
  codingPassed     Boolean?
  submittedAt      DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([userId, questionId])
}

model QuestionAssignment {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId String
  question   Question  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  dueAt      DateTime?
  examMode   Boolean   @default(false)
  assignedAt DateTime  @default(now())

  @@unique([userId, questionId])
  @@index([userId])
}

model AssignmentTemplate {
  id          String                       @id @default(cuid())
  name        String                       @unique
  description String                       @default("")
  createdAt   DateTime                     @default(now())
  updatedAt   DateTime                     @updatedAt
  questions   AssignmentTemplateQuestion[]
}

model AssignmentTemplateQuestion {
  id         String             @id @default(cuid())
  templateId String
  template   AssignmentTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  questionId String
  question   Question           @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([templateId, questionId])
  @@index([templateId])
}

model TimeSpent {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId  String
  question    Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  timeSpentMs Int      @default(0)
  updatedAt   DateTime @updatedAt

  @@unique([userId, questionId])
  @@index([userId])
}
